# Скопировать в .env перед первым запуском.
POSTGRES_USER=arm
POSTGRES_PASSWORD=arm
POSTGRES_DB=arm

DATABASE_URL=postgresql+psycopg://arm:arm@db:5432/arm
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
MLFLOW_TRACKING_URI=http://mlflow:5000
# Запасное хранилище моделей. Работает, когда сервер трекинга недоступен.
ARTIFACTS_DIR=artifacts

# Коды направлений через запятую. Пусто — набор по умолчанию из четырёх.
# Пятое направление FLOOD_RISK включается только здесь.
ENABLED_DIRECTIONS=

# Вход в систему. Разбор — docs/09-auth.md и ADR 0007.
# Ключ подписи токенов. Пусто — ключ создаётся случайным на каждый запуск, и
# перезапуск сервера снимает все сессии. На стенде задайте своё значение.
AUTH_SECRET=
# Срок токена сессии в минутах. Восемь часов это смена диспетчера.
AUTH_TOKEN_TTL_MINUTES=480
# Срок промежуточного токена между паролем и кодом, в секундах.
AUTH_MFA_TTL_SECONDS=300
# Пароль демонстрационных учётных записей команды seed.
SEED_PASSWORD=collector

# Режим тестового стенда. Открывает панель учётных записей на экране входа:
# список наборов с логинами, паролем и отметкой о втором факторе, кнопки
# создать и удалить набор.
#
# ВНИМАНИЕ. Флаг раздаёт логины и пароли любому, кто открыл страницу входа.
# Он существует ради жюри, чтобы каждый проверяющий взял свой набор и завёл
# второй фактор в своём телефоне. В промышленной установке он обязан быть
# выключен: включённый флаг делает вход бессмысленным.
TEST_STAND=
